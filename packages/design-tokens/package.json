{
  "name": "@rowerm8/design-tokens",
  "version": "0.1.0",
  "description": "Pure-data design tokens for the RowerM8 app and the future marketing website. No React Native imports allowed.",
  "private": true,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./colors": "./src/colors.ts",
    "./hr-zones": "./src/hr-zones.ts",
    "./achievements": "./src/achievements.ts",
    "./chart": "./src/chart.ts",
    "./typography": "./src/typography.ts",
    "./spacing": "./src/spacing.ts",
    "./radius": "./src/radius.ts",
    "./motion": "./src/motion.ts"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-tokens.ts",
    "lint": "eslint --config eslint.config.mjs src scripts"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
